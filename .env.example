# Class-Planner 환경 변수 — 로컬에서는 .env.local로 복사 후 값 입력.
#
# .env.local은 gitignore되어 안전. production 환경 변수는 Vercel/CI dashboard에서 설정.

# ===== Supabase (필수) =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ===== E2E 테스트 (auth 의존 spec 사용 시 필수) =====
# scripts/setup-e2e-test-user.ts 실행으로 사전 생성한 test user 정보.
# 누락 시 auth 의존 e2e spec(teachers/templates 등)은 globalSetup에서 throw.
E2E_TEST_USER_EMAIL=e2e-test@class-planner.test
E2E_TEST_USER_PASSWORD=
# Optional — globalSetup이 매번 listUsers 호출 안 하도록 사전 저장
E2E_TEST_USER_ID=

# ===== Supabase admin (e2e cleanup용) =====
# 매 spec 후 test user 데이터 삭제 (RLS 우회 위해 service role).
# 누락 시 cleanup 건너뜀 (test 간 leakage 가능).
SUPABASE_SERVICE_ROLE_KEY=

# ===== omni-radar production observability (Phase 1 self-host) =====
# Mac Studio omni-radar (dev-pack/omni-radar) endpoint + Bearer token.
# 둘 다 미설정 시 sendErrorEvent noop (e2e/preview/dev 자동 비활성).
# omni-radar `.env.local` 의 OMNI_RADAR_TOKEN 과 동일 값 사용.
# 진짜 secret 아님 (브라우저 노출) — casual abuse 방어 + ALLOWED_ORIGINS 가 진짜 방어.
# 상세: dev-pack/omni-radar/docs/ROADMAP-production-observability.md § Phase 1
NEXT_PUBLIC_OMNI_RADAR_URL=https://radar.deepcraft.app
NEXT_PUBLIC_OMNI_RADAR_TOKEN=
